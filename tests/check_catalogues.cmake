# S-111 FC + PC pair.
expect_sha("${C}/S-111/S-111_FC_2.0.0.xml" 6701de3b38540bac2a998f1fe1cd8d1a88b038a4bd71d750322ca9c377fe93a7)
expect_sha("${C}/S-111/PC_2.0.0/portrayal_catalogue.xml" 40789188f6074e1849b0650d546812043d07a8fa58f18ebe350183c6a0c10e94)
