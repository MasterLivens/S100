# S-104 FC only; FATAL if PC_2.0.0/ appears (official N/A for Ed.2.0.0).
expect_sha("${C}/S-104/S-104_FC_2.0.0.xml" a8e3fa6af176b380d8efe6730edcc4af9c7c8f39f7b889ca9499191c05ec7dfd)
